{
  "_comment": "FleetManagement/package.json",
  "name": "fleet-management",
  "version": "0.1.0",
  "private": true,
  "description": "Intermodal Fleet Platform — pnpm/Turborepo monorepo root",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=50%",
    "lint": "turbo run lint --concurrency=50%",
    "typecheck": "turbo run typecheck --concurrency=50%",
    "test": "turbo run test:unit --concurrency=50%",
    "verify": "turbo run build typecheck lint test:unit --concurrency=50%",
    "build:fresh": "turbo run build --force --concurrency=50%",
    "typecheck:fresh": "turbo run typecheck --force --concurrency=50%",
    "verify:fresh": "turbo run build typecheck lint test:unit --force --concurrency=50%",
    "verify:ci": "turbo run build --force --concurrency=1 && turbo run typecheck lint test:unit --force --concurrency=50%",
    "dev": "turbo run dev",
    "codemod": "tsx packages/codemods/src/cli.ts",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test:e2e": "playwright test",
    "e2e:ops-web": "tsx scripts/e2e/ops-web-runner.ts",
    "test:e2e:ui": "playwright test --ui",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "commitlint": "commitlint --edit",
    "codemod:check": "tsx packages/codemods/src/cli.ts extract-parse-one-number --project workers/main-worker/tsconfig.json --include \"packages/domain/src/**/*.ts\" --check",
    "ci:fast": "turbo run __ci_fast__",
    "sync:main": "tsx scripts/sync-main.ts",
    "stack:up": "tsx scripts/e2e/stack-up.ts",
    "stack:e2e:isolated": "tsx scripts/e2e/stack-e2e-isolated.ts",
    "release:closeout": "tsx scripts/e2e/release-closeout.ts",
    "release:promote": "tsx scripts/e2e/release-promote.ts",
    "guard:railway-references": "tsx scripts/railway-reference-guard.ts",
    "stack:restart": "tsx scripts/e2e/stack-restart.ts",
    "stack:stop": "tsx scripts/e2e/stack-stop.ts",
    "docker:reclaim": "tsx scripts/e2e/docker-reclaim.ts",
    "test:scripts": "vitest run scripts",
    "deploy:railway": "node -e \"console.error('Production deploys run via CI only. Trigger with: gh workflow run railway-deploy.yml --ref main -f services=auto'); process.exit(1)\"",
    "ci:resolve-sha": "tsx scripts/ci/resolve-ci-sha.ts",
    "knip": "knip",
    "knip:files": "knip --files",
    "knip:dependencies": "knip --dependencies",
    "knip:exports": "knip --exports",
    "sync:worktrees": "tsx scripts/sync-worktrees.ts",
    "compose:env": "tsx scripts/compose-identity.ts --env .env",
    "compose:print": "tsx scripts/compose-identity.ts --print",
    "sync:develop": "tsx scripts/sync-develop.ts",
    "bump:pnpm": "tsx scripts/bump-pnpm.ts",
    "bump:turbo": "tsx scripts/bump-turbo.ts",
    "audit:ci-minutes": "tsx scripts/ci/ci-minutes-fetch.ts",
    "worktree:close": "tsx scripts/worktree-close-cli.ts",
    "deps:reconcile": "tsx scripts/deps-reconcile-cli.ts",
    "git:merge-drivers": "tsx scripts/git-merge-drivers.ts",
    "worktree:sweep": "tsx scripts/sweep-worktrees-cli.ts",
    "inspect:prod-deploy": "tsx scripts/inspect-prod-deploy.ts",
    "pr:follow": "tsx scripts/pr-follow.ts",
    "pr:automerge": "tsx scripts/pr-automerge.ts",
    "gate:integration": "tsx scripts/gate-integration.ts",
    "gate:coverage": "tsx scripts/gate-coverage.ts",
    "gate:agent": "tsx scripts/gate-agent.ts",
    "prod:db-url": "tsx scripts/prod-db-url.ts",
    "guard:local-secrets": "tsx scripts/local-secret-guard.ts",
    "guard:local-secrets:baseline": "tsx scripts/local-secret-guard-baseline.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "lint:scripts": "eslint scripts --max-warnings=0",
    "eas:ios:device": "pnpm exec turbo run eas:build:ios:interactive --filter=@fleet/driver-app --ui=tui",
    "eas:freshness": "tsx scripts/eas-build-freshness-gate.ts",
    "terminal:census": "tsx scripts/terminal-registry-cli.ts census",
    "terminal:claim": "tsx scripts/terminal-registry-cli.ts claim",
    "lint:e2e": "eslint e2e --max-warnings=0",
    "lint:e2e:fix": "eslint e2e --fix",
    "lint:scripts:fix": "eslint scripts --fix",
    "secrets:baseline": "tsx scripts/secrets-baseline.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/eslint-plugin": "^1.6.16",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "^4.4.0",
    "execa": "^9.6.1",
    "knip": "^6.29.0",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "tsx": "^4.21.0",
    "turbo": "^2.10.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.2",
    "vite": ">=8.0.16",
    "vitest": "^4.1.4",
    "zod": "catalog:"
  }
}
