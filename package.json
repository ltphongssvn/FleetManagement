{
  "_comment": "FleetManagement/package.json",
  "name": "fleet-management",
  "version": "0.1.0",
  "private": true,
  "description": "Intermodal Fleet Platform — pnpm/Turborepo monorepo root",
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engines": {
    "node": ">=22.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=50%",
    "lint": "turbo run lint --concurrency=50%",
    "typecheck": "turbo run typecheck --concurrency=50%",
    "test": "turbo run test:unit --concurrency=50%",
    "dev": "turbo run dev",
    "codemod": "tsx packages/codemods/src/cli.ts",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "test:e2e": "playwright test",
    "e2e:ops-web": "tsx scripts/e2e/ops-web-runner.ts",
    "test:e2e:ui": "playwright test --ui",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "commitlint": "commitlint --edit",
    "codemod:check": "tsx packages/codemods/src/cli.ts extract-parse-one-number --project workers/main-worker/tsconfig.json --include \"packages/domain/src/**/*.ts\" --check",
    "ci:fast": "turbo run __ci_fast__",
    "sync:main": "tsx scripts/sync-main.ts",
    "stack:up": "tsx scripts/e2e/stack-up.ts",
    "release:closeout": "tsx scripts/e2e/release-closeout.ts",
    "release:promote": "tsx scripts/e2e/release-promote.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "exceljs": "^4.4.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/eslint-plugin": "^1.6.16",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "execa": "^9.6.1",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.3",
    "tsx": "^4.21.0",
    "turbo": "^2.9.18",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4",
    "zod": "^4.4.3",
    "vite": ">=8.0.16"
  }
}
