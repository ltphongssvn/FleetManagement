# Dockerfile.api - Railway target wrapper for api service
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo
FROM base AS builder
RUN apk add --no-cache build-base python3
COPY . .
RUN pnpm install --frozen-lockfile && \
    pnpm exec turbo run build --filter=@fleet/api... && \
    pnpm --filter=@fleet/api deploy --prod --no-optional --legacy /tmp/api-deploy
FROM node:22-alpine
WORKDIR /app
# Build-info self-report: Railway injects RAILWAY_GIT_COMMIT_SHA at deploy.
# Surfaced as GIT_SHA so /health/version reports the running commit at runtime
# (read from process.env per request; not baked into the build).
ARG RAILWAY_GIT_COMMIT_SHA
ARG RAILWAY_GIT_BRANCH
ENV GIT_SHA=${RAILWAY_GIT_COMMIT_SHA}
ENV GIT_BRANCH=${RAILWAY_GIT_BRANCH}
# Build-info self-report: Railway injects RAILWAY_GIT_COMMIT_SHA at deploy.
# Surfaced as GIT_SHA so /health/version reports the running commit at runtime
# (read from process.env per request; not baked into the build).
ARG RAILWAY_GIT_COMMIT_SHA
ARG RAILWAY_GIT_BRANCH
ENV GIT_SHA=${RAILWAY_GIT_COMMIT_SHA}
ENV GIT_BRANCH=${RAILWAY_GIT_BRANCH}
COPY --from=builder /tmp/api-deploy /app
COPY --from=builder /repo/apps/api/dist /app/dist
COPY --from=builder /repo/apps/api/src/database/migrations /app/dist/database/migrations
EXPOSE 3000
CMD ["node", "--import", "./dist/observability/otel-bootstrap.js", "dist/main.js"]
