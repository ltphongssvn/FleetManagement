# Dockerfile.api - Railway target wrapper for api service
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo
FROM base AS builder
RUN apk add --no-cache build-base python3
COPY . .
RUN pnpm install --frozen-lockfile && \
    pnpm exec turbo run build --filter=@fleet/api... && \
    pnpm --filter=@fleet/api deploy --prod --no-optional --legacy /tmp/api-deploy
FROM node:22-alpine
WORKDIR /app
COPY --from=builder /tmp/api-deploy /app
COPY --from=builder /repo/apps/api/dist /app/dist
COPY --from=builder /repo/apps/api/src/database/migrations /app/dist/database/migrations
EXPOSE 3000
CMD ["node", "--import", "./dist/observability/otel-bootstrap.js", "dist/main.js"]
