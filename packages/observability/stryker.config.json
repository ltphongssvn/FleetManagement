{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for security-critical PII redaction. Validates tests catch redaction-logic mutations.",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/sentry-scrub.ts",
    "src/dsn.ts",
    "src/sentry-init.ts",
    "src/scrubber-config.ts"
  ],
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 90
  },
  "concurrency": 2,
  "timeoutMS": 30000,
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental.json",
  "plugins": [
    "@stryker-mutator/vitest-runner",
    "@stryker-mutator/typescript-checker"
  ]
}
