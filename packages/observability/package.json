{
  "name": "@fleet/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Shared observability primitives: PII scrubber for Sentry events across api, ops-web, driver-app",
  "sideEffects": false,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "fast-check": "^4.7.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
