{
  "_comment": "FleetManagement/packages/codemods/package.json",
  "name": "@fleet/codemods",
  "version": "0.1.0",
  "private": true,
  "description": "AST-based codemod infrastructure (ts-morph) + workspace orchestrator for the Intermodal Fleet Platform. Replaces fragile text-based replacement scripts with type-aware, reference-safe transforms.",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fleet-codemods": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});for(const f of fs.readdirSync('.'))if(f.endsWith('.tsbuildinfo'))fs.rmSync(f,{force:true});\" && tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test:mutation": "stryker run"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "ts-morph": "^28.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "fast-check": "^4.7.0"
  }
}
