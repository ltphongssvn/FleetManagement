{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/index.ts",
    "!**/test/**",
    "!**/dist/**",
    "!src/transport/road-run-presentation.ts",
    "!src/transport/road-run-state.ts",
    "!src/transport/transport-order-state.ts"
  ],
  "thresholds": {
    "high": 95,
    "low": 80,
    "break": 90
  },
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental.json",
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "concurrency": 4,
  "timeoutMS": 10000,
  "coverageAnalysis": "perTest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ]
}
