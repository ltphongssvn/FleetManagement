{
  "name": "@fleet/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design-token SSOT (Zod-validated): base ramps, spacing/type/radii/shadow/motion scales, and a semantic role layer. Emitted to ops-web (Tailwind v4 @theme CSS variables) and the React Native apps (theme/tokens.ts) so every surface shares one source of truth.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./emit-ops-web": {
      "types": "./dist/emit-ops-web.d.ts",
      "import": "./dist/emit-ops-web.js"
    },
    "./literal-guard": {
      "types": "./dist/literal-guard.d.ts",
      "import": "./dist/literal-guard.js"
    },
    "./react-native": {
      "types": "./src/react-native.ts",
      "react-native": "./src/react-native.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "rm -rf dist .turbo *.tsbuildinfo coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "^4.1.4"
  }
}
