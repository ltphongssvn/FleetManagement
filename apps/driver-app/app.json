{
  "expo": {
    "name": "Fleet Driver",
    "slug": "fleet-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fleetdriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fleetmanagement.driver",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.fleetmanagement.driver",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "fleet-driver",
          "organization": "fleetmanagement"
        }
      ],
      "@sentry/react-native",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ứng dụng cần quyền truy cập máy ảnh để bạn chụp ảnh phiếu cân hàng làm bằng chứng nhận/giao hàng tại kho."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "networkSecurityConfig": "./plugins/network_security_config.xml"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/transport_alert.wav"
          ],
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/0d98c859-b2bc-4412-be8d-f9bc83bbb239",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "0d98c859-b2bc-4412-be8d-f9bc83bbb239"
      },
      "router": {}
    },
    "owner": "ltphongssvn",
    "locales": {
      "vi": "./locales/vi.json"
    }
  }
}
