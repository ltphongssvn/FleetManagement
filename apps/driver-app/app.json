{
  "expo": {
    "name": "Fleet Driver",
    "slug": "fleet-driver",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fleetdriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fleetmanagement.driver",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fleetmanagement.driver",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "fleet-driver",
          "organization": "fleetmanagement"
        }
      ],
      "@sentry/react-native",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "\u1ee8ng d\u1ee5ng c\u1ea7n quy\u1ec1n truy c\u1eadp m\u00e1y \u1ea3nh \u0111\u1ec3 b\u1ea1n ch\u1ee5p \u1ea3nh phi\u1ebfu c\u00e2n h\u00e0ng l\u00e0m b\u1eb1ng ch\u1ee9ng nh\u1eadn/giao h\u00e0ng t\u1ea1i kho."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/0d98c859-b2bc-4412-be8d-f9bc83bbb239",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "0d98c859-b2bc-4412-be8d-f9bc83bbb239"
      },
      "router": {}
    },
    "owner": "ltphongssvn",
    "locales": {
      "vi": "./locales/vi.json"
    }
  }
}
