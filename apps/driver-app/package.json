{
  "name": "@fleet/driver-app",
  "version": "0.1.0",
  "private": true,
  "description": "Expo native driver app (phones + Android tablets); Expo Web read-only fallback",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "rimraf .expo dist .turbo coverage",
    "eas-build-pre-install": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @fleet/observability --filter @fleet/sync-protocol --filter @fleet/domain build",
    "ios": "expo start --ios",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "start": "expo start",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD~1",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json",
    "web": "expo start --web"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.11",
    "@fleet/observability": "workspace:*",
    "@fleet/sync-protocol": "workspace:*",
    "@sentry/react-native": "^8.11.1",
    "@tanstack/react-query": "^5.100.11",
    "drizzle-orm": "^0.45.2",
    "expo": "^55.0.23",
    "expo-auth-session": "~55.0.15",
    "expo-crypto": "~55.0.14",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "^55.0.15",
    "expo-router": "~55.0.14",
    "expo-secure-store": "~55.0.13",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3",
    "uuid": ">=14.0.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/react": "~19.2.14",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/coverage-v8": "4.1.4",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.7.0",
    "rimraf": "^6.0.1"
  }
}
