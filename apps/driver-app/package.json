{
  "name": "@fleet/driver-app",
  "version": "0.1.0",
  "private": true,
  "description": "Expo native driver app (phones + Android tablets); Expo Web read-only fallback",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "check": "echo check is a turbo aggregate task -- run: pnpm exec turbo run check --filter=@fleet/driver-app",
    "clean": "rimraf .expo dist .turbo coverage",
    "eas-build-pre-install": "cd ../.. && pnpm install --frozen-lockfile && pnpm exec turbo run build --filter=@fleet/driver-app^...",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "start": "expo start",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD~1",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json",
    "web": "expo start --web",
    "eas:builds": "pnpm dlx eas-cli@20.5.1 build:list --platform all --limit 10 --non-interactive",
    "eas:build:ios": "pnpm dlx eas-cli@20.5.1 build --platform ios --profile preview --non-interactive",
    "eas:build:ios:interactive": "pnpm dlx eas-cli@20.5.1 build --platform ios --profile preview",
    "eas:build:android": "pnpm dlx eas-cli@20.5.1 build --platform android --profile preview --non-interactive"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "@expo/app-integrity": "^57.0.0",
    "@expo/metro-runtime": "~55.0.12",
    "@fleet/design-tokens": "workspace:*",
    "@fleet/observability": "workspace:*",
    "@fleet/sync-protocol": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.100.11",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.29",
    "expo-auth-session": "~55.0.18",
    "expo-build-properties": "~55.0.17",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.18",
    "expo-device": "~55.0.20",
    "expo-image-picker": "~55.0.23",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.26",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.17",
    "expo-sqlite": "~55.0.19",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.27",
    "expo-web-browser": "~55.0.19",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3",
    "uuid": ">=14.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fleet/test-fixtures": "workspace:*",
    "@sentry/cli": "2.58.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/react": "~19.2.14",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/coverage-v8": "4.1.4",
    "drizzle-kit": "^0.31.10",
    "expo-doctor": "1.18.24",
    "fast-check": "^4.7.0",
    "rimraf": "^6.0.1"
  }
}
