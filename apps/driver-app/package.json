{
  "_comment": "FleetManagement/apps/driver-app/package.json",
  "name": "@fleet/driver-app",
  "version": "0.1.0",
  "private": true,
  "description": "Expo native driver app (phones + Android tablets); Expo Web read-only fallback",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "rimraf .expo dist .turbo coverage"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.10",
    "@fleet/sync-protocol": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "expo": "^55.0.17",
    "expo-linking": "^55.0.14",
    "expo-router": "~55.0.13",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "~55.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.7.0",
    "rimraf": "^6.0.1"
  }
}
