<?xml version="1.0" encoding="utf-8"?>
<!--
  apps/driver-app/plugins/network_security_config.xml
  Domain-scoped Android network security config (driver-app-security arc, Phase 5).
  Wired via expo-build-properties android.networkSecurityConfig in app.json.

  base-config: cleartext FORBIDDEN in production, with an explicit system
  trust-anchor so HTTPS to xe.vominhchau.com keeps full CA validation. (A prior
  global usesCleartextTraffic:true generated a base-config with NO trust-anchors,
  which overrode the system CA store and broke HTTPS on device.)

  domain-config: cleartext PERMITTED only for the local E2E hosts so the Maestro
  release flow can reach the api over adb-reversed HTTP. The production host is
  deliberately absent here -- it is served by the secure base-config over HTTPS.

  MASVS-NETWORK / MASTG-TEST-0235 compliant; guarded by
  test/mobile-native-bundle-config.test.ts against production cleartext drift.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </domain-config>
</network-security-config>
