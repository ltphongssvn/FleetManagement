{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-native",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "react",
      "react-native"
    ],
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "app/**/*",
    "vitest.config.ts"
  ]
}
