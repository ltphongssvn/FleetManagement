{
  "name": "@fleet/owner-app",
  "version": "0.1.0",
  "private": true,
  "description": "Expo native owner app: at-a-glance driver-app adoption dashboard for the company owner",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "clean": "rimraf .expo dist .turbo coverage",
    "eas-build-pre-install": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @fleet/observability --filter @fleet/sync-protocol --filter @fleet/domain build",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "start": "expo start",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD~1",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json",
    "web": "expo start --web",
    "eas:builds": "pnpm dlx eas-cli@20.5.1 build:list --platform all --limit 10 --non-interactive",
    "eas:device": "pnpm dlx eas-cli@20.5.1 device:create",
    "eas:build:ios": "pnpm dlx eas-cli@20.5.1 build --platform ios --profile preview --non-interactive",
    "eas:build:ios:interactive": "pnpm dlx eas-cli@20.5.1 build --platform ios --profile preview"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.11",
    "@fleet/observability": "workspace:*",
    "@fleet/sync-protocol": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.100.11",
    "expo": "^55.0.26",
    "expo-auth-session": "~55.0.16",
    "expo-build-properties": "~55.0.14",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-linking": "^55.0.15",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.24",
    "expo-web-browser": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/react": "~19.2.14",
    "@vitest/coverage-istanbul": "^4.1.5",
    "@vitest/coverage-v8": "4.1.4",
    "rimraf": "^6.0.1"
  }
}
