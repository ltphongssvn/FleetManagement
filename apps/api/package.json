{
  "_comment": "FleetManagement/apps/api/package.json",
  "name": "@fleet/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS modular monolith (Socket.IO gateway added week 4 per day-one plan)",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "echo check is a turbo aggregate task -- run: pnpm exec turbo run check --filter=@fleet/api",
    "clean": "rimraf dist .turbo coverage && rimraf \"*.tsbuildinfo\"",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prebuild": "rimraf dist *.tsbuildinfo",
    "start": "node --import ./dist/observability/otel-bootstrap.js dist/main.js",
    "start:dev": "tsx --import ./src/observability/otel-bootstrap.ts src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "rm -rf coverage && VITEST_ENFORCE_THRESHOLDS=1 vitest run --config vitest.coverage.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "tsx ../../scripts/db-generate.ts",
    "db:migrate": "drizzle-kit migrate",
    "intake:redrive": "tsx src/scripts/intake-redrive.ts",
    "projection:rebuild": "tsx src/scripts/projection-rebuild.ts",
    "inspect:order-state": "tsx src/scripts/inspect-order-state.ts",
    "inspect:review-parse": "tsx src/scripts/inspect-review-parse.ts",
    "repair:complete-delivered-runs": "tsx src/scripts/repair-complete-delivered-runs.ts",
    "repair:ghost-runs": "tsx src/scripts/repair-ghost-runs.ts",
    "audit:device-registry": "tsx src/scripts/audit-device-registry.ts",
    "audit:assignment-uniqueness": "tsx src/scripts/audit-assignment-uniqueness.ts",
    "db:check": "drizzle-kit check",
    "test:changed": "vitest run --changed HEAD~1",
    "test:mutation": "stryker run",
    "audit:driver-roster": "tsx src/scripts/audit-driver-roster.ts"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@fleet/domain": "workspace:*",
    "@fleet/main-worker": "workspace:*",
    "@fleet/observability": "workspace:*",
    "@fleet/sync-protocol": "workspace:*",
    "@levischuck/tiny-cbor": "0.2.11",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/websockets": "^11.1.19",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/context-async-hooks": "^2.7.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@peculiar/asn1-android": "2.7.0",
    "@peculiar/asn1-schema": "2.7.0",
    "@peculiar/x509": "1.14.3",
    "@sentry/nestjs": "^10.51.0",
    "@simplewebauthn/server": "^13.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^3.15.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "mime-types": "^3.0.2",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@fleet/test-fixtures": "workspace:*",
    "@nestjs/testing": "^11.1.19",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "^8.2.7",
    "@types/mime-types": "^3.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.7.0",
    "ioredis-mock": "^8.13.1",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.3",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.2"
  }
}
