# apps/api/.env.example
# Copy to apps/api/.env (gitignored) and fill in real values.

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://localhost:5432/fleet_dev
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# OIDC (corporate IdP first, Keycloak fallback)
OIDC_ISSUER=https://idp.example.com/
OIDC_AUDIENCE=fleet-api
OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json
