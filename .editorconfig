# FleetManagement/.editorconfig
# EditorConfig ensures consistent formatting across editors that may not
# have Prettier installed. Complements .prettierrc — editors read this
# natively without plugins.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
