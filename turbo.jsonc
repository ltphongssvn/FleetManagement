// FleetManagement/turbo.jsonc
// Turborepo 2.x pipeline — verified against turbo@2.9.6
{
  "$schema": "./node_modules/turbo/schema.json",

  "envMode": "strict",

  "globalDependencies": [
    "pnpm-lock.yaml",
    ".nvmrc",
    ".node-version",
    ".github/workflows/**"
  ],

  "globalEnv": ["CI"],

  "globalPassThroughEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "GITHUB_TOKEN",
    "VERCEL_TOKEN",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "FEATURE_FLAGS_*"
  ],

  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },

  "remoteCache": {
    "enabled": false,
    "signature": true
  },

  "tasks": {
    "transit": {
      "description": "Graph-only node for dependency-aware parallel tasks",
      "dependsOn": ["^transit"]
    },

    "build": {
      "description": "Compile production artifacts (NestJS dist, Next.js .next, Expo build)",
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**", "out/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "APP_VERSION", "BUILD_ID"],
      "outputLogs": "new-only"
    },

    "lint": {
      "description": "Static analysis (ESLint)",
      "dependsOn": ["^lint"],
      "cache": true,
      "outputs": ["eslint-report.json", ".eslintcache"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".eslintrc*",
        "eslint.config.*",
        ".eslintignore"
      ],
      "outputLogs": "new-only"
    },

    "lint:fix": {
      "description": "Auto-fix lint violations — never cached, local/manual invocation only",
      "dependsOn": [],
      "cache": false
    },

    "typecheck": {
      "description": "TypeScript verification (parallel via transit, not serialized behind builds)",
      "dependsOn": ["transit"],
      "cache": true,
      "outputs": ["*.tsbuildinfo", "dist/**/*.d.ts"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputLogs": "new-only"
    },

    "test": {
      "description": "CI test run — source-based, parallel via transit node",
      "dependsOn": ["transit"],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**", "junit.xml"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "TESTCONTAINERS_*", "VITEST_*", "JEST_*"],
      "outputLogs": "new-only"
    },

    "test:unit": {
      "description": "Unit tests only — fastest cacheable feedback loop",
      "dependsOn": ["transit"],
      "cache": true,
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*"
      ],
      "env": ["VITEST_*", "JEST_*"],
      "outputLogs": "new-only"
    },

    "test:watch": {
      "description": "Fast local TDD loop (Red-Green-Refactor). Package scripts invoke 'vitest --watch' or 'jest --watch'.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },

    "test:integration": {
      "description": "Integration tests — need built artifacts + Testcontainers services",
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "TESTCONTAINERS_*"],
      "outputLogs": "new-only"
    },

    "test:e2e": {
      "description": "End-to-end tests (Playwright) — never cached across envs",
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["DATABASE_URL", "REDIS_URL", "API_BASE_URL", "TESTCONTAINERS_*"]
    },

    "ci": {
      "description": "Aggregate CI gate: lint + typecheck + test + build in parallel DAG. Invoke with --summarize in CI for run metrics.",
      "dependsOn": ["lint", "typecheck", "test", "build"],
      "cache": false
    },

    "graph": {
      "description": "Generate pipeline DAG visualization. Root script runs 'turbo run ci --graph=docs/pipeline.mermaid'.",
      "cache": false
    },

    "dev": {
      "description": "Local dev server (persistent, turbo watch-aware)",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },

    "clean": {
      "description": "Remove build artifacts and caches",
      "cache": false
    }
  }
}
