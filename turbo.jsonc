// ============================================================================
// File:     FleetManagement/turbo.jsonc
// Purpose:  Root Turborepo 2.x pipeline configuration.
// Rationale: See docs/adr/001-turborepo-pipeline.md for full decision record.
// Related:  package.json, pnpm-workspace.yaml, tsconfig.base.json,
//           .github/workflows/ci.yml, .pre-commit-config.yaml, .gitignore
// ============================================================================
{
  "$schema": "./node_modules/turbo/schema.json",
  "envMode": "strict",
  "globalDependencies": [
    ".nvmrc",
    ".node-version",
    ".github/workflows/**"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "VERCEL_ENV",
    "FEATURE_FLAGS_*"
  ],
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },
  // Remote caching is the single largest lever on this repo CI bill. Measured
  // (//#audit:ci-minutes, Jul 1-4, 244 runs): ci.yml burned 1440 billable
  // minutes over 63 runs -- 22.9 min/run against ~9 min of wall clock, ~67% of
  // the whole account. The cause is that caching was disabled at BOTH layers at
  // once: enabled:false here, plus --force in ci.yml, plus a fresh runner per
  // job. So all 8 jobs in a run re-install and rebuild the same five packages
  // from zero, every run. Locally the same 37-task gate finishes in 24s off the
  // shared worktree cache; a fresh worktree restores a full build in 6s with
  // FULL TURBO. Identical work, identical tool -- CI was simply forbidden to
  // remember anything. enabled:false carried no description in a file where
  // every task documents its rationale: it was an unrevisited default, not a
  // decision.
  //
  // No Vercel account is involved: rharkor/caching-for-turbo backs the Turbo
  // Remote Cache API with GitHub Actions own cache and injects TURBO_API /
  // TURBO_TOKEN / TURBO_TEAM per job. Any HTTP server implementing the API
  // works, so this stays portable.
  //
  // signature:true is KEPT, and it is a live trap worth stating plainly: Turbo
  // HMAC-SHA256-signs artifacts with TURBO_REMOTE_CACHE_SIGNATURE_KEY, and any
  // artifact that fails verification is silently TREATED AS A CACHE MISS. It
  // was set here while remote caching was off, so it had never been exercised
  // and no key existed. Flipping enabled:true alone would have produced a 100%
  // miss rate that looks exactly like a working cache -- the same shape as the
  // confident zeros the audit tool exists to refuse. The key is now a repo
  // secret and every job that runs turbo must export it.
  "remoteCache": {
    "enabled": true,
    "signature": true
  },
  "tasks": {
    "__transit__": {
      "description": "Graph-only node. Double-underscore reduces but does not guarantee collision-freedom; reserved internal name — see ADR-001.",
      "dependsOn": ["^__transit__"]
    },
    "build": {
      "description": "Compile production artifacts (NestJS dist, Next.js .next, Expo build). Owns dist/** exclusively. BUILD_ID policy: MUST NOT be read during build. Stamping happens at deploy time (commit SHA metadata) or runtime env — never consumed by build scripts. Not declared here (neither env nor passThroughEnv) because it must not be visible.",
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**", "out/**", "**/*.tsbuildinfo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "APP_VERSION"],
      "outputLogs": "new-only"
    },
    "lint": {
      "description": "Static analysis (ESLint). dependsOn ^build (not just ^lint): the type-aware @typescript-eslint/no-unsafe-* rules need upstream workspace packages' emitted .d.ts to resolve cross-package import types. Without ^build, a clean CI checkout has no dist/ for @fleet/* deps, so those imports resolve to 'any' and the rules fire — passing locally (where dist/ exists) but failing CI. ^build guarantees parity. ^lint retained so the shared eslint-config lints itself before consumers. Hashes package-local + root ESLint configs + root tsconfig. Produces no cacheable artifacts (plain 'eslint .'), so outputs is [].",
      "dependsOn": ["^build", "^lint"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".eslintrc*",
        "eslint.config.*",
        ".eslintignore",
        "$TURBO_ROOT$/.eslintrc*",
        "$TURBO_ROOT$/eslint.config.*",
        "$TURBO_ROOT$/.eslintignore",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputLogs": "new-only"
    },
    "lint:fix": {
      "description": "Auto-fix lint violations — never cached, local/manual invocation only",
      "dependsOn": [],
      "cache": false
    },
    "typecheck": {
      "description": "Pure TypeScript verification (tsc --noEmit). dependsOn ^build (not just the __transit__ ordering node): cross-package imports of @fleet/* resolve to each dependency's EMITTED .d.ts, not its source -- the same constraint the lint task documents. Without ^build a clean or --force run (no prior dist/) fails with TS2307 'Cannot find module @fleet/...' because upstream declarations are not emitted yet; it only passed before by relying on a warm dist/ from an earlier build. ^build guarantees upstream .d.ts exist, matching real CI. (If cross-package source-resolution via TS project references were wired, an ^topo node like __transit__ would suffice and keep typecheck fully parallel -- see ADR-001.) Produces no cacheable artifact (a pass/fail check), so outputs is [] -- the build task owns **/*.tsbuildinfo. Letting BOTH own it let Turbo restore a buildinfo from a foreign run, and tsc --incremental then replayed stale module resolution (the TS2307 we hit, plus the 'no output files' warning). When composite:true + declaration emission is needed, split into a types:build task per ADR-001.",
      "dependsOn": ["^build", "__transit__"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.*.json"
      ],
      "outputLogs": "new-only"
    },
    "test:unit": {
      "description": "Unit tests only — fastest cacheable feedback loop. Produces no cacheable artifacts (plain 'vitest run', no --coverage, no file reporter); coverage/** is owned by test:coverage. Declaring outputs here triggered Turbo's 'no output files found' warning on cache write. Hashes package-local + root test configs + root tsconfig (transforms/path aliases depend on it). Also dependsOn ^build (not just __transit__) so vitest/vite resolves @fleet/* imports to each package built dist before tests run; without it a purged or --force run races the upstream build destructive rebuild and fails with 'Failed to resolve entry for package @fleet/observability'.",
      "dependsOn": ["^build", "__transit__"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*",
        "$TURBO_ROOT$/vitest.config.*",
        "$TURBO_ROOT$/vitest.workspace.*",
        "$TURBO_ROOT$/jest.config.*",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["VITEST_*", "JEST_*"],
      "outputLogs": "new-only"
    },
    "check": {
      "description": "Per-package composite verification aggregate: lint + typecheck + test:unit as GRAPH DEPENDENCIES (parallel where the graph allows, each individually cached), then the package check script, which is an echo MARKER ONLY. Root cause this eliminates (recurred 3+ sessions): script/task vocabulary mismatch -- packages defined a check pnpm script (pnpm lint && pnpm typecheck && pnpm test) that was never a registered turbo task, so pnpm exec turbo run check failed with Could-not-find-task (distinct from the branch-staleness cause in context/turbo-root-task-staleness-bootstrap.md). The old && composite is the documented 2026 anti-pattern (sequential, unfilterable, cache-opaque); the dependsOn graph replaces it, mirroring the __ci_fast__ orchestration-node house pattern but package-scoped and filterable. Direct in-package pnpm check verifies NOTHING by design -- the marker prints the sanctioned invocation. cache:false: the marker is zero-work; caching lives in the dependency tasks. Run: pnpm exec turbo run check --filter=@fleet/<pkg>.",
      "dependsOn": ["lint", "typecheck", "test:unit"],
      "cache": false
    },
    "test:watch": {
      "description": "Fast local TDD loop (Red-Green-Refactor). Package scripts invoke 'vitest --watch' or 'jest --watch'.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "projection:rebuild": {
      "description": "Rebuild dispatch_board_projection for one scope from the event feed (sanctioned rebuild path). Boots a minimal standalone Nest context (ProjectionRebuildModule). Live DB mutation: cache:false. passThroughEnv exposes DATABASE_URL + FLEET_PILOT_SCOPE under strict envMode. Run: pnpm exec turbo run projection:rebuild --filter=@fleet/api -- --scope <companyId>.",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["DATABASE_URL", "FLEET_PILOT_SCOPE"]
    },
    "intake:redrive": {
      "description": "Emit compensating manifest_intake.requested outbox events for manifests stranded in verifying (Jun-24 expired-worker-token incident repair). Event-sourcing repair protocol: events flow THROUGH outbox -> relay -> BullMQ -> worker -> finalizeIntake; manifest state is never hand-patched. DRY-RUN by default; mutation needs --execute AND FLEET_ALLOW_INTAKE_REDRIVE=true (wipe-business-data speed-bump pattern). Live DB access: cache:false. Run: pnpm exec turbo run intake:redrive --filter=@fleet/api [-- --execute].",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["DATABASE_URL", "FLEET_ALLOW_INTAKE_REDRIVE"]
    },
    "repair:ghost-runs": {
      "description": "Event-sourced ghost-run repair: cancel every non-terminal road_run whose linked transport_orders are all terminal (or that has zero links) by appending road_run.cancelled through appendTriWrite, letting the projection runner heal dispatch_board. DRY-RUN by default; pass -- --execute to mutate. Live DB mutation: cache:false. passThroughEnv DATABASE_URL + FLEET_PILOT_SCOPE under strict envMode. Run: pnpm exec turbo run repair:ghost-runs --filter=@fleet/api [-- --execute].",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["DATABASE_URL", "FLEET_PILOT_SCOPE"]
    },
    "audit:device-registry": {
      "description": "READ-ONLY audit of device_registry fabrication from the manual pre-enroll path. Runs the unit-tested auditDeviceRegistry classifier against live rows and prints duplicate-udid groups, platform monoculture, placeholder-version count, and active device_session blast-radius. No mutation, no --execute. Live DB read: cache:false. passThroughEnv DATABASE_URL under strict envMode. Run: pnpm exec turbo run audit:device-registry --filter=@fleet/api.",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "audit:assignment-uniqueness": {
      "description": "READ-ONLY audit of driver-vehicle assignment-pair uniqueness. Runs the unit-tested auditAssignmentUniqueness classifier against live ACTIVE assignment rows and prints any duplicate driver/vehicle/pair groups (violations of the 1:1 partial-unique-index invariant). --introspect mode instead prints whether the two dva_one_active_* partial-unique indexes exist and are VALID in prod (drift check). No mutation. Live DB read: cache:false. passThroughEnv DATABASE_URL + FLEET_PILOT_SCOPE under strict envMode. Run: pnpm exec turbo run audit:assignment-uniqueness --filter=@fleet/api [-- --introspect].",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["DATABASE_URL", "FLEET_PILOT_SCOPE"]
    },
    "inspect:order-state": {
      "description": "Read-only diagnostic: print a transport order actual server-side state (transport_order row, linked road_run states + started_at/completed_at, last 20 fleet_audit_log events) resolved by --ref. Boots the standalone ProjectionRebuildModule (config + database). MUTATES NOTHING. Live DB read: cache:false. passThroughEnv DATABASE_URL + FLEET_PILOT_SCOPE under strict envMode. Run: pnpm exec turbo run inspect:order-state --filter=@fleet/api -- --ref XTT.07-020.",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["DATABASE_URL", "FLEET_PILOT_SCOPE"]
    },
    "inspect:review-parse": {
      "description": "Read-only diagnostic: reproduce the dispatcher-review producer (findByCompanyIdOrRef) for --ref and run its output through ListAssignedRowSchema.safeParse to reveal whether the review-page parse throws and on which path. Isolates the review-page crash. MUTATES NOTHING. Live DB read: cache:false. passThroughEnv DATABASE_URL + FLEET_PILOT_SCOPE under strict envMode. Run: pnpm exec turbo run inspect:review-parse --filter=@fleet/api -- --ref XTT.07-043.",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["DATABASE_URL", "FLEET_PILOT_SCOPE"]
    },
    "repair:complete-delivered-runs": {
      "description": "Event-sourced completion reconciler: drive every non-terminal road_run whose linked transport_orders are ALL fully photo-committed (committed manifests >= stop count, the same predicate the live completion gate enforces) to completed by appending road_run.completed through appendTriWrite, letting the projection runner heal dispatch_board. Heals runs stranded when intake lagged or the old departedAt-proxy made completion unreachable. DRY-RUN by default; pass -- --execute to mutate. Live DB mutation: cache:false. passThroughEnv DATABASE_URL + FLEET_PILOT_SCOPE under strict envMode. Run: pnpm exec turbo run repair:complete-delivered-runs --filter=@fleet/api [-- --execute].",
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["DATABASE_URL", "FLEET_PILOT_SCOPE"]
    },
    "test:integration": {
      "description": "Integration tests — need own + upstream builds + Testcontainers. Owns coverage/integration/** + test-results/integration/**.",
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/integration/**", "test-results/integration/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*",
        "$TURBO_ROOT$/vitest.config.*",
        "$TURBO_ROOT$/vitest.workspace.*",
        "$TURBO_ROOT$/jest.config.*",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "TESTCONTAINERS_*"],
      "outputLogs": "new-only"
    },
    "db:generate": {
      "description": "Generate Drizzle SQL migrations by diffing the schema barrel against meta/ snapshots (drizzle-kit generate). Mutates the source tree (src/database/migrations/**), so cache:false -- a cache replay could materialize stale SQL from a foreign run. No build dependency: drizzle-kit reads .ts schema sources directly. passThroughEnv DATABASE_URL under strict envMode (drizzle.config.ts references it; generate itself never connects). Run: pnpm exec turbo run db:generate --filter=@fleet/api.",
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "eas:builds": {
      "description": "List recent EAS cloud builds (Android + iOS) for the driver app via eas-cli build:list. Read-only network query against Expo servers, so cache:false (no deterministic output) and no build dependency. passThroughEnv exposes EXPO_TOKEN (auth; set persistently via ~/.expo-env) and EAS_PROJECT_ID under strict envMode. Run: pnpm exec turbo run eas:builds --filter=@fleet/driver-app.",
      "cache": false,
      "passThroughEnv": ["EXPO_TOKEN", "EAS_PROJECT_ID"]
    },
    "eas:build:ios": {
      "description": "Dispatch an iOS Ad Hoc (preview profile) EAS cloud build of the driver app via eas-cli build. --non-interactive auto-includes every device already registered on the ad hoc provisioning profile server-side (no App Store Connect API Key, no device-selection prompt), so a driver iPhone registered via the eas device:create QR flow is baked into the new .ipa. Waits for the build (no --no-wait) so the operator gets the install link; CI uses --no-wait for fire-and-forget. Remote build + Apple credential network mutation: cache:false, no build dependency (EAS builds remotely). passThroughEnv exposes EXPO_TOKEN (auth; set persistently via ~/.expo-env) and EAS_PROJECT_ID under strict envMode. Run: pnpm exec turbo run eas:build:ios --filter=@fleet/driver-app.",
      "cache": false,
      "passThroughEnv": ["EXPO_TOKEN", "EAS_PROJECT_ID"]
    },
    "eas:build:android": {
      "description": "Dispatch an Android (preview profile) EAS cloud build of the driver app via eas-cli build, producing an installable APK. --non-interactive requires no prompts (Android internal distribution is not device-UDID-scoped, unlike iOS Ad Hoc). Waits for the build (no --no-wait) so the operator gets the install link; CI uses --no-wait for fire-and-forget. Remote build network operation: cache:false, no build dependency (EAS builds remotely). passThroughEnv exposes EXPO_TOKEN (auth; set persistently via ~/.expo-env) and EAS_PROJECT_ID under strict envMode. Run: pnpm exec turbo run eas:build:android --filter=@fleet/driver-app.",
      "cache": false,
      "passThroughEnv": ["EXPO_TOKEN", "EAS_PROJECT_ID"]
    },
    "test:coverage": {
      "description": "Coverage-gated tests — runs unit + integration with merged coverage thresholds. Owns coverage/merged/** + coverage/unit/**. Used by CI quality gate.",
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/merged/**", "coverage/unit/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.coverage.config.*",
        "vitest.integration.config.*",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "TESTCONTAINERS_*", "VITEST_*"],
      "outputLogs": "new-only"
    },
    "test:mutation": {
      "description": "Stryker mutation testing — slow (minutes per package). Each package config sets its own break threshold. Cache key includes src/** + test/** + stryker.config.json so a clean repo state replays from .stryker-tmp/incremental.json.",
      "dependsOn": [],
      "outputs": ["reports/mutation/**", ".stryker-tmp/incremental.json"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "stryker.config.json",
        "vitest.config.*",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["STRYKER_*"],
      "outputLogs": "new-only"
    },
    "//#test:e2e": {
      "description": "End-to-end tests (Playwright), repo-root task. The playwright config lives at the repo root (testDir ./e2e, workers 1) and the spec-runner is the root 'test:e2e' script, so this spans packages and MUST be root-scoped (the '//#' prefix). A prior package-level 'test:e2e' task was dead: no package exposes a test:e2e script, so 'turbo run test:e2e --filter=@fleet/ops-web' ran zero tasks. env declares the vars the e2e run actually reads (E2E_* base/api URLs, OIDC_* for the IdP authorize flow, PLAYWRIGHT_* runtime) so they pass the envMode:strict boundary; the old task listed DATABASE_URL/API_BASE_URL/TESTCONTAINERS_* which the Playwright run does not consume. Owns playwright-report/**. cache:false until a migration-hash key is wired (ADR-001).",
      "cache": false,
      "env": ["E2E_*", "OIDC_*", "PLAYWRIGHT_*"]
    },
    "//#stack:e2e:isolated": {
      "description": "Root-level task: raise the ISOLATED per-worktree browser-E2E stack (infra + api + ops-web, NO driver/expo/android) on this worktree deterministic compose ports (compose-identity), health-gated (docker compose up --wait), run Playwright via the existing ops-web-runner with identity-derived E2E_BASE_URL/E2E_API_URL, then tear the stack down (down -v). Prefix //# ensures repo-root-only (spans packages + the whole compose stack, not a per-package task). Replaces the ad-hoc docker compose + inline E2E_* env pattern with one rediscoverable op. env declares the vars the run reads so they pass envMode:strict. cache:false (side-effecting: docker + network). Run: pnpm exec turbo run stack:e2e:isolated -- e2e/dispatch-board-search.spec.ts.",
      "cache": false,
      "env": ["E2E_*", "OIDC_*", "PLAYWRIGHT_*", "FLEET_*"]
    }
,
    "__ci_fast__": {
      "description": "PR gate orchestration node — lint + typecheck + test:unit + codemod drift gate. Double-underscore prevents package-script collision. Expose via root package.json script 'ci:fast' for friendly CLI. CI workflow should matrix-split (ADR-001).",
      "dependsOn": ["lint", "typecheck", "test:unit", "//#codemod:check", "//#test:scripts", "//#lint:scripts", "//#guard:local-secrets"],
      "cache": false
    },
    "__ci_full__": {
      "description": "Pre-merge gate orchestration node — cumulative on __ci_fast__ + build + test:integration.",
      "dependsOn": ["__ci_fast__", "build", "test:integration", "test:coverage"],
      "cache": false
    },
    "__ci_release__": {
      "description": "Release/nightly gate orchestration node — cumulative on __ci_full__ + test:e2e.",
      "dependsOn": ["__ci_full__", "//#test:e2e"],
      "cache": false
    },
    "__ci__": {
      "description": "Alias orchestration node for __ci_fast__ (GitFlow PR convention).",
      "dependsOn": ["__ci_fast__"],
      "cache": false
    },
    "//#codemod:check": {
      "description": "Root-level task: run the @fleet/codemods drift gate (extract-parse-one-number --check) across the worker tsconfig spanned with @fleet/domain source. Prefix '//#' ensures repo-root-only (it spans packages, so it is not a per-package task). Fails when source still has an un-migrated parseOneNumber outside @fleet/domain. Wired into __ci_fast__ so PRs fail on drift. cache:false — it is a fast in-memory AST pass with no cacheable output.",
      "cache": false
    },
    "//#lint:scripts": {
      "description": "Root-level task: ESLint the repo-level tooling in scripts/. Prefix //# ensures repo-root-only. Exists because the package-scoped lint task CANNOT reach scripts/: that tree belongs to no workspace package, so turbo run lint skipped it entirely and the only way to lint a root script was a bare eslint invocation -- an uncaptured, unrediscoverable op that no gate ran. Same shape as the guards being wired into a turbo node CI never invoked: the check existed in principle and nowhere in practice. Pairs with //#test:scripts (vitest) so root tooling gets the same lint+test treatment every package gets. cache:false -- a pass/fail check with no cacheable output, matching codemod:check and test:scripts. Run: pnpm exec turbo run lint:scripts.",
      "cache": false
    },
    "//#lint:scripts:fix": {
      "description": "Root-level task: ESLint --fix over scripts/. Mutates the source tree, so cache:false -- a cache replay could restore stale content. Companion to lint:scripts; local/manual invocation, never wired into a gate (a gate must verify, not rewrite). Run: pnpm exec turbo run lint:scripts:fix.",
      "cache": false
    },
    "//#test:scripts": {
      "description": "Root-level task: run the vitest suite that covers the repo-level tooling in scripts/ (sync-worktrees, sync-develop, close-worktree, worktree-close-cli, compose-identity, db-generate, railway-reference-guard, the e2e stack drivers, the ci-minutes reconciler). Prefix //# ensures repo-root-only: these scripts belong to no workspace package (2026 Turborepo guidance is package-tasks-first; this is the carve-out for genuinely repo-spanning tooling), so a per-package task would find nothing. Runs the committed root script 'test:scripts' (vitest run scripts) verbatim -- it is NOT a second runner. Wired into __ci_fast__ so a regression in the worktree-deletion logic (which removes branches) fails the PR gate instead of merging green; before this the suite passed but the gate never executed it. cache:false -- a pass/fail check with no cacheable output, matching codemod:check.",
      "cache": false
    },
    "//#audit:ci-minutes": {
      "description": "Root-level task: READ-ONLY audit attributing BILLABLE GitHub Actions minutes to the workflow that spent them, then reconciling the total against the enhanced billing platform. Prefix //# ensures repo-root-only (it spans no package; it reads the repo CI ledger). Computed from /actions/runs/{id}/jobs records, never /actions/workflows/{id}/timing -- that endpoint is closing down and returns 0ms while billing shows five figures. Billing meters JOB execution rounded UP per job, so a 4-way shard matrix cuts wall clock but not minutes, and a 12-second gate job still bills one. Absent data throws rather than scoring 0 (three confident-zero hazards observed in this domain, including GitHub docs saying product=Actions while the wire sends product=actions). Exits 2 when computed-vs-billed drift exceeds 5%: the instrument is wrong and no cut may be sized on it. cache:false (live network read, no cacheable output). passThroughEnv exposes the API token under strict envMode. Run: pnpm exec turbo run audit:ci-minutes [-- --year 2026 --month 7].",
      "cache": false,
      "persistent": false,
      "passThroughEnv": ["GITHUB_TOKEN", "GH_TOKEN", "GITHUB_API_URL", "GITHUB_REPOSITORY"]
    },
    "//#inspect:prod-deploy": {
      "description": "Root-level task: READ-ONLY diagnostic answering whether a fix commit is actually RUNNING in a given live deploy and whether it is PROMOTED to the base branch. Prefix //# ensures repo-root-only (it reads the git/deploy ledger, spans no package). Pure git ancestry: fix-in-base (promoted?), fix-in-live (running?), base-ahead-of-live count. Verdict EFFECTIVE / REDEPLOY-NEEDED / NOT-PROMOTED with NON-ZERO exit unless EFFECTIVE, so it gates scripts and CI, not just prints. Always emits a RAILWAY MANUAL CHECK line for the one fact git cannot prove -- whether the container was BUILT after a required build var existed. Token-free (local git only): no passThroughEnv. cache:false (live git read, no cacheable output). Run: pnpm exec turbo run inspect:prod-deploy -- --live <sha> --fix <sha> [--base <ref>].",
      "cache": false,
      "persistent": false
    },
    "//#prod:db-url": {
      "description": "Root-level task: print the CURRENT production Postgres DSN, read LIVE from Railway (the single system of record) at call time. Prefix //# ensures repo-root-only (it spans no package). Exists to kill a recurring class of failure: operators pasted a PROD_DATABASE_URL literal into a local .env, prod credentials rotated, the copy went stale, and every prod-ops task (audit:*, inspect:*, projection:rebuild, repair:*) failed authentication with an opaque error. A stored copy is a SECOND system of record and always rots; re-pasting is a treadmill. This is the local-ops mirror of guard:railway-references, which forbids the same literal-vs-reference anti-pattern in Railway service variables. ONLY the DSN goes to stdout (diagnostics to stderr) so it composes via command substitution. Retries transient Railway API errors; fails immediately on auth/linkage errors -- there is no safe fallback for a prod DSN. cache:false (live network read, no cacheable output). Run: DATABASE_URL=$(pnpm prod:db-url) pnpm exec turbo run audit:assignment-uniqueness --filter=@fleet/api.",
      "cache": false,
      "persistent": false
    },
    "//#guard:local-secrets": {
      "description": "Root-level task: fail when a PRODUCTION credential literal sits in a local env file (.env, .env.local, .env.production, .env.prod). Prefix //# ensures repo-root-only. Covers a genuine blind spot rather than duplicating existing protection: pre-commit check-env-files blocks COMMITTING a .env and detect-secrets scans STAGED content, but a local .env is untracked BY DESIGN so neither ever inspects it -- which is exactly how a stale PROD_DATABASE_URL sat undetected until prod rotated. Only PROD/PRODUCTION-scoped variable names holding an inline-credential URL are flagged, so an ordinary local docker-compose DATABASE_URL stays legitimate. Reports file, line and variable NAME only, never the value. Exit 1 on violation, 2 on tooling error. cache:false (reads working-tree state outside the task graph). Run: pnpm exec turbo run guard:local-secrets.",
      "cache": false,
      "persistent": false
    },
    "//#guard:local-secrets:baseline": {
      "description": "Root-level task: regenerate scripts/local-secret-guard.config.json, the SHA-256 hashes of production hostnames that must never appear in tracked source. Prefix //# ensures repo-root-only. The hash is DERIVED AT RUNTIME from the live Railway value via the same resolver the ops tasks use, so the plaintext hostname is never typed into a tracked file -- a guard whose own config leaked the topology it protects would be self-defeating. Mirrors the hashed_secret field in .secrets.baseline. Reports a hash prefix only, never the hostname. cache:false (live network read). Run: pnpm exec turbo run guard:local-secrets:baseline.",
      "cache": false,
      "persistent": false
    },
    "//#sync:worktrees": {
      "description": "Root-level task: fast-forward every git worktree local branch to its remote tracking branch, SAFELY. Prefix //# ensures repo-root-only (it spans all worktrees, not a per-package task). Fast-forwards only when a branch is purely behind (behind>0, ahead=0); REFUSES and warns on true divergence (ahead>0 AND behind>0), never force-merging/resetting, so unpushed local commits can never be lost. The autonomous pipeline converges the REMOTE branches but git never auto-updates LOCAL worktree branches, so this closes that gap. cache:false (side-effecting git operation, no cacheable output). Run: pnpm exec turbo run sync:worktrees.",
      "cache": false
    },
    "//#sync:develop": {
      "description": "Root-level task: merge origin/develop DOWN into the current feature branch (2026 conflict-prevention). Prefix //# ensures repo-root-only. Refuses on dirty tree; no-op on develop/main; on conflict exits 1 with the conflicted paths for evidence-driven resolution (rerere replays known hunks). STANDING RULE: run after every milestone push and immediately before gh pr create so every PR is born mergeable, never DIRTY. cache:false (side-effecting git operation). Run: pnpm exec turbo run sync:develop.",
      "cache": false
    },
    "//#bump:pnpm": {
      "description": "Root-level task: bump the corepack-pinned pnpm version for the whole repo via corepack use pnpm@<version|latest> -- resolves the version and rewrites the packageManager pin + sha512 in package.json itself (2026 canonical; never pnpm add -g, which fails on this box because the global bin dir is not on PATH and would only mutate one machine anyway). Script refuses on a dirty tree so the pin change is always an isolated, reviewable commit. Prefix //# ensures repo-root-only. cache:false (side-effecting, network-resolving). Run: pnpm exec turbo run bump:pnpm [-- <version>].",
      "cache": false
    },
    "//#worktree:close": {
      "description": "Root-level task: close a git worktree SAFELY -- remove the worktree and delete its local branch, but ONLY when nothing can be lost. Prefix //# ensures repo-root-only (it spans all worktrees, not a per-package task). REFUSES on any loss risk and reports every reason at once: primary-clone, no-upstream, unpushed (ahead>0), dirty (any modified or untracked file), unmerged (commits not contained in origin/develop). Never passes --force, -D or -f, so git own merged-check is the last line of defence. Complements sync:worktrees, which fast-forwards but has no removal path -- closing a worktree was previously a hand-rolled git idiom, not a captured op. Decision core (scripts/close-worktree.ts) and parsers (scripts/worktree-close.ts) are pure and unit-tested; only the driver touches git. cache:false (side-effecting git mutation, no cacheable output). Run: pnpm exec turbo run worktree:close -- <worktree-path>.",
      "cache": false
    },
    "//#graph": {
      "description": "Root-level task: generate pipeline DAG visualization (Mermaid for ADR/docs). Prefix '//#' ensures repo-root-only. For live operational inspection prefer 'turbo devtools' (2.7+) — browser-based package/task graph.",
      "cache": false
    },
    "dev": {
      "description": "Local dev server (persistent, turbo watch-aware)",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "clean": {
      "description": "Remove build artifacts and caches",
      "cache": false
    }
  }
}
