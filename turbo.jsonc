// ============================================================================
// File:     FleetManagement/turbo.jsonc
// Purpose:  Root Turborepo 2.x pipeline configuration for the Intermodal
//           Fleet Platform monorepo. Defines the task graph, caching rules,
//           environment contracts, and execution semantics that every
//           workspace (apps/*, workers/*, packages/*) inherits.
//
// Why it exists:
//   The Frozen Stack (Fleet-Management-Stack.pdf) mandates
//   "pnpm workspaces + Turborepo; Node/TS only" as the monorepo foundation.
//   This file is the single source of truth for how Turborepo orchestrates
//   builds, tests, lint, typecheck, and dev loops across the Expo
//   driver-app, Next.js ops-web, NestJS api, and BullMQ worker. It also
//   encodes the PDF's TDD + Testcontainers mandate by splitting tests into
//   unit / integration / e2e tasks with different cache semantics and
//   splits CI gates (ci:fast vs ci:full) to make quality tiers explicit.
//
// Key decisions / invariants (all empirically verified against turbo@2.9.6):
//   - Format: turbo.jsonc (native // comments). Schema pinned to installed
//     turbo via ./node_modules/turbo/schema.json.
//   - envMode: "strict" — only declared env vars visible at runtime.
//   - CRITICAL env hashing discipline (verified):
//       * NODE_ENV, VERCEL_ENV, FEATURE_FLAGS_* are in globalEnv (HASHED).
//         Passthrough would cause stale-cache correctness bugs: a dev-mode
//         build could be served for a prod invocation (verified identical
//         hash for NODE_ENV=development vs production under passthrough).
//       * Remote-cache secret tokens (TURBO_TOKEN, TURBO_TEAM, GITHUB_TOKEN,
//         VERCEL_TOKEN) are NOT declared here — turbo reads them from
//         process env natively. Declaring them globally would expose to
//         every task; least-privilege places them on specific tasks only
//         if/when a task script consumes them.
//   - pnpm-lock.yaml intentionally NOT in globalDependencies: docs + test
//     confirm root lockfile is already part of global hash automatically.
//   - Quality gates DECOUPLED from builds via transit node:
//       * lint      dependsOn ["^lint"]      — shared-config stability
//       * typecheck dependsOn ["transit"]    — parallel, not serialized
//       * test      dependsOn ["transit"]    — source-based, fast TDD
//   - Tests needing SAME-package build artifacts use ["build", "^build"]:
//       * test:integration — needs own dist + upstream dists
//       * test:e2e         — needs full build
//     Verified: ^build alone only produces upstream deps (a#build), adding
//     "build" additionally produces self (b#build).
//   - CI tiers are EXPLICIT (no hidden policy):
//       * ci:fast — lint + typecheck + test:unit (PR gate, <2 min target)
//       * ci:full — ci:fast + test:integration (pre-merge to main)
//       * ci      — alias for ci:fast for GitFlow PR convention
//     test:e2e runs on separate release/nightly gate, not in ci:full.
//   - futureFlags enable task-granular --affected and turbo watch
//     (both stable per docs, not experimental).
//
// FUTURE WORK (when apps/packages land):
//   - Root .env is NOT auto-tracked by $TURBO_DEFAULT$ when filtering to
//     specific packages (verified). If apps/* read root .env, add it to
//     globalDependencies explicitly. Per-app .env files ARE auto-tracked.
//   - When composite: true TS project references land, split typecheck:
//       * typecheck   — tsc --noEmit verification (pure, no outputs)
//       * types:build — declaration emission (outputs *.d.ts, .tsbuildinfo)
//     Keeps pure tasks separate from artifact-emitting tasks.
//   - Replace wildcard NEXT_PUBLIC_*/EXPO_PUBLIC_* in build.env with
//     workspace-level turbo.jsonc (extends: ["//"]). $TURBO_DEFAULT$
//     auto-tracks per-package .env files, so per-app configs can drop
//     explicit env lists entirely. Wildcards at root over-invalidate.
//   - Enable remoteCache + signature after Turborepo Cloud signup.
//     Omitted from this config until enabled (avoids smell).
//   - Wire test:e2e migration-aware caching when Drizzle migrations exist
//     (Week 3 per PDF): add "$TURBO_ROOT$/<real-path>/migrations/**/*.sql"
//     to test:e2e.inputs and flip cache:false -> cache:true.
//   - Consolidate test runner + linter once chosen in Week 1:
//       * Vitest only: drop "jest.config.*" from test* inputs
//       * Jest only:   drop "vitest.config.*" and "vitest.workspace.*"
//       * Flat ESLint: drop ".eslintrc*" from lint.inputs
//       * Biome: replace lint task with biome.json inputs, .biomecache output
//
// Related files:
//   - package.json              — packageManager, engines, root scripts
//   - pnpm-workspace.yaml       — workspace topology
//   - tsconfig.base.json        — shared TS compiler options
//   - .github/workflows/ci.yml  — invokes ci:fast / ci:full tasks
//   - .pre-commit-config.yaml   — local mirror of these gates
//   - .gitignore                — excludes .turbo, dist, coverage
// ============================================================================
{
  "$schema": "./node_modules/turbo/schema.json",

  "envMode": "strict",

  "globalDependencies": [
    ".nvmrc",
    ".node-version",
    ".github/workflows/**"
  ],

  // Hashed: changes bust cache (output-affecting env vars)
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "VERCEL_ENV",
    "FEATURE_FLAGS_*"
  ],

  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },

  "tasks": {
    "transit": {
      "description": "Graph-only node for dependency-aware parallel tasks",
      "dependsOn": ["^transit"]
    },

    "build": {
      "description": "Compile production artifacts (NestJS dist, Next.js .next, Expo build)",
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**", "out/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "APP_VERSION", "BUILD_ID"],
      "outputLogs": "new-only"
    },

    "lint": {
      "description": "Static analysis (ESLint). ^lint ensures shared eslint-config package (future packages/eslint-config) lints itself before consumers use it.",
      "dependsOn": ["^lint"],
      "cache": true,
      "outputs": ["eslint-report.json", ".eslintcache"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".eslintrc*",
        "eslint.config.*",
        ".eslintignore"
      ],
      "outputLogs": "new-only"
    },

    "lint:fix": {
      "description": "Auto-fix lint violations — never cached, local/manual invocation only",
      "dependsOn": [],
      "cache": false
    },

    "typecheck": {
      "description": "TypeScript verification (parallel via transit, not serialized behind builds). When composite:true TS project references land, split into typecheck (--noEmit) + types:build (see FUTURE WORK).",
      "dependsOn": ["transit"],
      "cache": true,
      "outputs": ["*.tsbuildinfo", "dist/**/*.d.ts"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputLogs": "new-only"
    },

    "test": {
      "description": "Generic test alias — source-based, parallel via transit. CI tiers should prefer test:unit / test:integration for explicit scope.",
      "dependsOn": ["transit"],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**", "junit.xml"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "TESTCONTAINERS_*", "VITEST_*", "JEST_*"],
      "outputLogs": "new-only"
    },

    "test:unit": {
      "description": "Unit tests only — fastest cacheable feedback loop (PR gate via ci:fast)",
      "dependsOn": ["transit"],
      "cache": true,
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*"
      ],
      "env": ["VITEST_*", "JEST_*"],
      "outputLogs": "new-only"
    },

    "test:watch": {
      "description": "Fast local TDD loop (Red-Green-Refactor). Package scripts invoke 'vitest --watch' or 'jest --watch'.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },

    "test:integration": {
      "description": "Integration tests — need own built artifacts + upstream builds + Testcontainers services. dependsOn includes 'build' (self) not just '^build' (upstream only).",
      "dependsOn": ["build", "^build"],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "TESTCONTAINERS_*"],
      "outputLogs": "new-only"
    },

    "test:e2e": {
      "description": "End-to-end tests (Playwright) — need own + upstream builds. Never cached until migration-hash inputs wired (see FUTURE WORK).",
      "dependsOn": ["build", "^build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["DATABASE_URL", "REDIS_URL", "API_BASE_URL", "TESTCONTAINERS_*"]
    },

    "ci:fast": {
      "description": "PR gate — lint + typecheck + test:unit. Target <2 min. Invoked by .github/workflows/ci.yml on push.",
      "dependsOn": ["lint", "typecheck", "test:unit"],
      "cache": false
    },

    "ci:full": {
      "description": "Pre-merge gate — ci:fast + test:integration. Run before merging to main.",
      "dependsOn": ["lint", "typecheck", "test:unit", "test:integration"],
      "cache": false
    },

    "ci": {
      "description": "Alias for ci:fast (GitFlow PR convention). Explicit tiers: ci:fast / ci:full above.",
      "dependsOn": ["ci:fast"],
      "cache": false
    },

    "graph": {
      "description": "Generate pipeline DAG visualization. Root script runs 'turbo run ci:full --graph=docs/pipeline.mermaid'.",
      "cache": false
    },

    "dev": {
      "description": "Local dev server (persistent, turbo watch-aware)",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },

    "clean": {
      "description": "Remove build artifacts and caches",
      "cache": false
    }
  }
}
