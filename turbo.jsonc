// FleetManagement/turbo.jsonc
// Turborepo 2.x pipeline — verified against turbo@2.9.6
// Decoupled quality gates, split test taxonomy, JSONC for inline comments
{
  "$schema": "https://turbo.build/schema.json",

  // NOTE: `ui` intentionally omitted. Turborepo auto-detects:
  //   - Local dev with TTY  → TUI (per-task log navigation, interactive shells)
  //   - CI (no TTY)         → stream/grouped logs automatically
  //   - Manual override     → turbo run ... --ui=stream|tui

  // Files that invalidate the global cache key.
  // pnpm-lock.yaml explicit: turbo does NOT auto-track it
  // (verified: Global Files=0 without declaration, =1 with).
  "globalDependencies": [
    "pnpm-lock.yaml",
    "tsconfig.base.json",
    ".nvmrc",
    ".node-version"
  ],

  "globalEnv": ["CI"],

  // Forwarded to tasks but NOT part of cache key
  "globalPassThroughEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "GITHUB_TOKEN",
    "VERCEL_TOKEN",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "FEATURE_FLAGS_*"
  ],

  "remoteCache": {
    "enabled": false,
    "signature": true
  },

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**", "out/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,js,jsx,json}",
        "package.json",
        "tsconfig.json",
        "tsconfig.*.json",
        "next.config.*",
        "nest-cli.json"
      ],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "APP_VERSION", "BUILD_ID"],
      "outputLogs": "new-only"
    },

    // Lint depends on ^typecheck (NOT ^lint): type-aware ESLint rules
    // need upstream .d.ts files. Verified ^lint self-chain provides no types.
    "lint": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": ["eslint-report.json", ".eslintcache"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        ".eslintrc*",
        "eslint.config.*",
        ".eslintignore",
        "package.json"
      ],
      "outputLogs": "new-only"
    },

    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": ["*.tsbuildinfo", "dist/**/*.d.ts"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json"
      ],
      "outputLogs": "new-only"
    },

    // Test runs against source, NO upstream dependency (verified standalone works)
    "test": {
      "dependsOn": [],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**", "junit.xml"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/**",
        "vitest.config.*",
        "jest.config.*",
        "package.json",
        "tsconfig.json"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "TESTCONTAINERS_*", "VITEST_*", "JEST_*"],
      "outputLogs": "new-only"
    },

    "test:unit": {
      "dependsOn": [],
      "cache": true,
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/unit/**",
        "vitest.config.*",
        "jest.config.*"
      ],
      "env": ["VITEST_*", "JEST_*"],
      "outputLogs": "new-only"
    },

    // Integration tests: Testcontainers-backed services; need ^build artifacts
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/integration/**",
        "vitest.config.*",
        "jest.config.*"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "TESTCONTAINERS_*"],
      "outputLogs": "new-only"
    },

    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["DATABASE_URL", "REDIS_URL", "API_BASE_URL", "TESTCONTAINERS_*"]
    },

    "ci": {
      "dependsOn": ["lint", "typecheck", "test", "build"],
      "cache": false
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },

    "clean": {
      "cache": false
    }
  }
}
