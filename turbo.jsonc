// ============================================================================
// File:     FleetManagement/turbo.jsonc
// Purpose:  Root Turborepo 2.x pipeline configuration.
// Rationale: See docs/adr/001-turborepo-pipeline.md for full decision record
//           (context, alternatives, invariants, future work, verification).
// Related:  package.json, pnpm-workspace.yaml, tsconfig.base.json,
//           .github/workflows/ci.yml, .pre-commit-config.yaml, .gitignore
// ============================================================================
{
  "$schema": "./node_modules/turbo/schema.json",

  "envMode": "strict",

  "globalDependencies": [
    ".nvmrc",
    ".node-version",
    ".github/workflows/**"
  ],

  "globalEnv": [
    "CI",
    "NODE_ENV",
    "VERCEL_ENV",
    "FEATURE_FLAGS_*"
  ],

  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  },

  "tasks": {
    "__transit__": {
      "description": "Graph-only node for dependency-aware parallel tasks. Double-underscore prefix prevents collision with package scripts.",
      "dependsOn": ["^__transit__"]
    },

    "build": {
      "description": "Compile production artifacts (NestJS dist, Next.js .next, Expo build).",
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**", "out/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "APP_VERSION", "BUILD_ID"],
      "outputLogs": "new-only"
    },

    "lint": {
      "description": "Static analysis (ESLint). ^lint ensures shared eslint-config package lints itself before consumers use it.",
      "dependsOn": ["^lint"],
      "outputs": ["eslint-report.json", ".eslintcache"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".eslintrc*",
        "eslint.config.*",
        ".eslintignore"
      ],
      "outputLogs": "new-only"
    },

    "lint:fix": {
      "description": "Auto-fix lint violations — never cached, local/manual invocation only",
      "dependsOn": [],
      "cache": false
    },

    "typecheck": {
      "description": "TypeScript verification (parallel via __transit__, not serialized behind builds).",
      "dependsOn": ["__transit__"],
      "outputs": ["*.tsbuildinfo", "dist/**/*.d.ts"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "tsconfig.*.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputLogs": "new-only"
    },

    "test:unit": {
      "description": "Unit tests only — fastest cacheable feedback loop (PR gate via ci:fast). Isolated coverage output: coverage/unit/**.",
      "dependsOn": ["__transit__"],
      "outputs": ["coverage/unit/**", "test-results/unit/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*"
      ],
      "env": ["VITEST_*", "JEST_*"],
      "outputLogs": "new-only"
    },

    "test:watch": {
      "description": "Fast local TDD loop (Red-Green-Refactor). Package scripts invoke 'vitest --watch' or 'jest --watch'.",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },

    "test:integration": {
      "description": "Integration tests — need own built artifacts + upstream builds + Testcontainers services. Isolated coverage output: coverage/integration/**.",
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/integration/**", "test-results/integration/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "vitest.config.*",
        "vitest.workspace.*",
        "jest.config.*"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "TESTCONTAINERS_*"],
      "outputLogs": "new-only"
    },

    "test:e2e": {
      "description": "End-to-end tests (Playwright) — need own + upstream builds. Never cached until migration-hash inputs wired (see ADR-001). Isolated output: playwright-report/**.",
      "dependsOn": ["build", "^build"],
      "cache": false,
      "env": ["DATABASE_URL", "REDIS_URL", "API_BASE_URL", "TESTCONTAINERS_*"]
    },

    "ci:fast": {
      "description": "PR gate — lint + typecheck + test:unit. Target <2 min. Local convenience; CI workflow should matrix-split (see ADR-001).",
      "dependsOn": ["lint", "typecheck", "test:unit"],
      "cache": false
    },

    "ci:full": {
      "description": "Pre-merge gate — ci:fast + test:integration. Run before merging to main. Local convenience.",
      "dependsOn": ["lint", "typecheck", "test:unit", "test:integration"],
      "cache": false
    },

    "ci": {
      "description": "Alias for ci:fast (GitFlow PR convention).",
      "dependsOn": ["ci:fast"],
      "cache": false
    },

    "//#graph": {
      "description": "Root-level task: generate pipeline DAG visualization. Root script runs 'turbo run ci:full --graph=docs/pipeline.mermaid'. Prefix '//#' ensures this runs once at repo root, not per-package.",
      "cache": false
    },

    "dev": {
      "description": "Local dev server (persistent, turbo watch-aware)",
      "cache": false,
      "persistent": true,
      "interruptible": true
    },

    "clean": {
      "description": "Remove build artifacts and caches",
      "cache": false
    }
  }
}
