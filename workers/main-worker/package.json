{
  "_comment": "FleetManagement/workers/main-worker/package.json",
  "name": "@fleet/main-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Single deployment with named BullMQ queues (outbox, projections, intake, reaper, erp, reminders, shadow-cleanup, arrival-hint-expiry, bootstrap-reaper, bootstrap-generator)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "echo check is a turbo aggregate task -- run: pnpm exec turbo run check --filter=@fleet/main-worker",
    "clean": "rimraf dist .turbo coverage && rimraf \"*.tsbuildinfo\"",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prebuild": "rimraf dist *.tsbuildinfo",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:unit": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@fleet/domain": "workspace:*",
    "@fleet/sync-protocol": "workspace:*",
    "bullmq": "^5.76.2",
    "ioredis": "^5.10.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fleet/test-fixtures": "workspace:*",
    "fast-check": "^4.7.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
