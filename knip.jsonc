// FleetManagement/knip.jsonc
// Dead-code gate: unused files, exports and dependencies across all 13
// workspaces. Root cause this closes: nothing in the repo could see a dead
// export, so SUPPORTED_LOCALES in ops-web i18n.ts sat unused with ZERO
// consumers repo-wide while its sibling Locale union drifted into three
// hand-written copies. eslint no-unused-vars cannot see this: it works
// within a file, never across the import graph.
//
// ADOPTION STAGE 2 of 3 (knip.dev/guides/adopt-gradually). The documented
// burn-down order is files -> dependencies -> exports, because one unused
// FILE hides its own exports and deps, so files must reach zero first. It
// has: `knip --files` reports "Excellent, Knip found no issues", so that
// rule is PROMOTED TO ERROR here and a newly-orphaned file now fails the
// task instead of adding a gray line nobody reads.
//
// The remaining rules stay warn while their config is tuned. That is the
// same adoption reasoning //#typecheck:scripts documents: it stayed ungated
// at 89 errors precisely so the gate would not be born red, and was promoted
// only when the count reached zero by fixing every error at its root.
//
// NOT YET WIRED INTO __ci_fast__. That is stage 3, and it happens when the
// task as a whole can pass -- promoting one rule while others still warn
// makes the task's exit code meaningful for that rule alone, which is
// exactly the incremental ratchet the guide prescribes.
//
// Entry-point decisions, each from an observed hint rather than assumption:
//   apps/api            src/main.ts REMOVED -- redundant, the plugin
//                       already resolves the NestJS bootstrap.
//   packages/codemods   src/cli.ts REMOVED -- same, found via the bin/
//                       script parser.
//   driver/owner-app    index.js REMOVED -- no such file on develop. Both
//                       apps use main:expo-router/entry, so every file
//                       under app/ is a route entry reached only by the
//                       router and never imported. (dispatcher-app adds a
//                       custom index.js on the T17 branch; when that lands,
//                       its workspace entry must list index.js or the
//                       polyfill and the whole route tree read as dead.)
//   apps/ops-web        src/middleware.ts REMOVED -- no such file. App
//                       Router page/layout/route files are entry by
//                       convention. .css added to project so Tailwind
//                       imports are followed (hint: compiled extension
//                       excluded by project).
//
// ignoreBinaries lists SYSTEM binaries only -- tools installed on the HOST
// and resolvable from no package.json, so reporting them is a category
// error rather than a finding. adb (Android platform-tools), flock
// (util-linux) and railway (Railway CLI) were the original three; four more
// were added 2026-08-19 and every one is a host tool //#doctor already
// verifies as a machine CAPABILITY:
//   pre-commit  the hook framework bootstrap:machine installs
//   sops        SOPS, spawned by env-bootstrap-cli for decrypt/encrypt
//   age-keygen  the age identity tool machine-doctor probes for
//   eas         the Expo CLI the build-freshness gate queries
// A machine missing any of them gets a named remediation from //#doctor,
// which is the right instrument for a host capability; knip reporting them
// as "unlisted" would be a second, weaker answer to a question already
// answered properly.
//
// drizzle-kit is deliberately NOT ignored: it is a real finding.
// scripts/db-generate.ts invokes it from the ROOT, but it is declared as a
// devDependency of apps/driver-app -- a genuine misplacement to fix, not
// suppress.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "adb",
    "age-keygen",
    "eas",
    "flock",
    "pre-commit",
    "railway",
    "sops"
  ],
  "rules": {
    "files": "error",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "unresolved": "warn",
    "binaries": "warn",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.ts"
      ],
      "project": [
        "scripts/**/*.ts"
      ],
      "includeEntryExports": true
    },
    "apps/api": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/ops-web": {
      "entry": [
        "src/app/**/{page,layout,route,template,error,loading,not-found}.tsx",
        "src/app/**/{page,layout,route,template,error,loading,not-found}.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}"
      ]
    },
    "apps/driver-app": {
      "entry": [
        "app/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "app/**/*.{ts,tsx}"
      ]
    },
    "apps/owner-app": {
      "entry": [
        "app/**/*.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "app/**/*.{ts,tsx}"
      ]
    },
    "workers/main-worker": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/domain": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/sync-protocol": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/observability": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/design-tokens": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/codemods": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/test-fixtures": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "e2e": {
      "entry": [
        "**/*.spec.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    }
  }
}
