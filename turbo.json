{
  "$schema": "https://turbo.build/schema.json",
  "//": "FleetManagement/turbo.json — Turborepo 2.x pipeline (decoupled quality gates, split test taxonomy)",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".nvmrc", ".node-version"],
  "globalEnv": ["CI"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "VERCEL_ENV",
    "GITHUB_TOKEN",
    "VERCEL_TOKEN",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "FEATURE_FLAGS_*"
  ],
  "remoteCache": {
    "enabled": false,
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**", "out/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,js,jsx,json}",
        "package.json",
        "tsconfig.json",
        "tsconfig.*.json",
        "next.config.*",
        "nest-cli.json"
      ],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*", "APP_VERSION", "BUILD_ID"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": ["eslint-report.json", ".eslintcache"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        ".eslintrc*",
        "eslint.config.*",
        ".eslintignore",
        "package.json"
      ],
      "outputLogs": "new-only"
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": ["*.tsbuildinfo", "dist/**/*.d.ts"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json"
      ],
      "outputLogs": "new-only"
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**", "junit.xml"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/**",
        "vitest.config.*",
        "jest.config.*",
        "package.json",
        "tsconfig.json"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "TESTCONTAINERS_*"],
      "outputLogs": "new-only"
    },
    "test:unit": {
      "dependsOn": ["^typecheck"],
      "cache": true,
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/unit/**",
        "vitest.config.*",
        "jest.config.*"
      ],
      "outputLogs": "new-only"
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/integration/**",
        "vitest.config.*",
        "jest.config.*"
      ],
      "env": ["DATABASE_URL", "REDIS_URL", "S3_ENDPOINT", "TESTCONTAINERS_*"],
      "outputLogs": "new-only"
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["DATABASE_URL", "REDIS_URL", "API_BASE_URL", "TESTCONTAINERS_*"]
    },
    "ci": {
      "dependsOn": ["lint", "typecheck", "test", "build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "clean": {
      "cache": false
    }
  }
}
